"""Local, persistent reminders. Dates use the computer's local clock."""
from __future__ import annotations

from dataclasses import asdict, dataclass
from datetime import datetime
import json
from pathlib import Path
from uuid import uuid4


@dataclass
class Reminder:
    id: str
    title: str
    due_at: str
    completed: bool = False

    @property
    def due_date(self) -> datetime:
        return datetime.fromisoformat(self.due_at)


class ReminderStore:
    def __init__(self, path: str | Path):
        self.path = Path(path)
        self.reminders: list[Reminder] = []
        self.load()

    def load(self) -> None:
        if not self.path.exists():
            self.reminders = []
            return
        items = json.loads(self.path.read_text(encoding="utf-8"))
        if not isinstance(items, list):
            raise ValueError("Reminder file must contain a list")
        self.reminders = [Reminder(**item) for item in items]

    def save(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        data = [asdict(reminder) for reminder in self.reminders]
        temporary = self.path.with_suffix(self.path.suffix + ".tmp")
        temporary.write_text(json.dumps(data, indent=2), encoding="utf-8")
        temporary.replace(self.path)

    def add(self, title: str, due_date: datetime) -> Reminder:
        if not title.strip():
            raise ValueError("Reminder title cannot be empty")
        if due_date <= datetime.now():
            raise ValueError("Reminder date/time must be in the future")
        reminder = Reminder(str(uuid4()), title.strip(), due_date.isoformat(timespec="minutes"))
        self.reminders.append(reminder)
        self.save()
        return reminder

    def mark_completed(self, reminder_id: str) -> None:
        for reminder in self.reminders:
            if reminder.id == reminder_id:
                reminder.completed = True
                self.save()
                return
        raise KeyError(reminder_id)

    def due(self, now: datetime | None = None) -> list[Reminder]:
        now = now or datetime.now()
        return [r for r in self.reminders if not r.completed and r.due_date <= now]

    def pending(self) -> list[Reminder]:
        return sorted((r for r in self.reminders if not r.completed), key=lambda r: r.due_at)
